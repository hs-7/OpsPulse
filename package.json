{
  "name": "opspulse",
  "version": "1.0.0",
  "description": "OpsPulse - Multi-tenant Webhook & Incident Management Platform",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test -- --watch=false",
    "db:migrate": "npm --prefix backend run db:migrate",
    "seed": "npm --prefix backend run seed",
    "start:backend": "npm --prefix backend run start:dev",
    "start:frontend": "npm --prefix frontend start"
  }
}
